# Supabase (PostgreSQL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Lokalise
LOKALISE_API_TOKEN="your_lokalise_api_token"
LOKALISE_PROJECT_ID="your_lokalise_project_id"
LOKALISE_BASE_LANGUAGE="ko"
LOKALISE_TARGET_LANGUAGES="en,en_CA,fr_CA"

# DeepL Translation (https://www.deepl.com/ko/pro-api → Free plan)
DEEPL_API_KEY="your_deepl_api_key"

# Sync Server
PORT=3001
HOST="0.0.0.0"
LOG_LEVEL="info"

# CORS (Figma plugin origin)
CORS_ORIGIN="*"
